project_id  = "your-gcp-project"
convex_site = "https://tame-crow-881.convex.site"
image       = "us-west2-docker.pkg.dev/your-gcp-project/go-tools/edge:latest"

# Day one: one region, its run.app URL, no domain, no load balancer.
regions = ["us-west2"]

# Later, for a spread-out team:
# regions = ["us-west2", "us-east1", "europe-west1"]
# domain  = "go.example.com"

# Same value as `npx convex env set EDGE_SYNC_SECRET ...`. This file is gitignored.
edge_sync_secret = "change-me"
